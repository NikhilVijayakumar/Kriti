{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "coverage-threshold result",
  "type": "object",
  "required": ["status", "line_coverage_pct", "threshold_pct"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "error"]
    },
    "line_coverage_pct": {
      "type": ["number", "null"]
    },
    "threshold_pct": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    }
  }
}
